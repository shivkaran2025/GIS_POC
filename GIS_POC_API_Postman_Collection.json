					"response": []
				},
				{
					"name": "Get KPI Timeseries (POST)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"entity_id\": \"{{entity_id}}\",\n  \"date\": \"{{date}}\",\n  \"kpi_metric\": \"{{kpi_metric}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/kpi-timeseries/timeseries",
							"host": ["{{base_url}}"],
							"path": ["api", "kpi-timeseries", "timeseries"]
						},
						"description": "Get KPI timeseries data using POST method"
					},
					"response": []
				},
				{
					"name": "Get KPI Timeseries by Table Type (GET)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/kpi-timeseries/timeseries/{{table_type}}/{{entity_id}}?date={{date}}&kpi_metric={{kpi_metric}}",
							"host": ["{{base_url}}"],
							"path": ["api", "kpi-timeseries", "timeseries", "{{table_type}}", "{{entity_id}}"],
							"query": [
								{
									"key": "date",
									"value": "{{date}}"
								},
								{
									"key": "kpi_metric",
									"value": "{{kpi_metric}}"
								}
							]
						},
						"description": "Get KPI timeseries data for specific table type"
					},
					"response": []
				},
